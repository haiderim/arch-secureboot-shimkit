[Unit]
Description=Restore missing Secure Boot signing hooks and sign any unsigned UKI
Documentation=https://github.com/haiderim/arch-secureboot-shimkit
After=local-fs.target
RequiresMountsFor=/boot

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/secureboot-restore-hooks.sh

[Install]
WantedBy=multi-user.target
